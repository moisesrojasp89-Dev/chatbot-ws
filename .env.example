# Puerto del servidor
PORT=3000
NODE_ENV=development

# Canales habilitados (CSV). El adaptador whatsapp exige credenciales META_*.
CHANNELS_ENABLED=whatsapp
# Pack de negocio (opcional): perfil + catálogo + prompt
# BUSINESS_PACK_PATH=packs/automotive/pack.json
MAX_CONVERSATION_TURNS=40
MAX_CONVERSATION_TOKENS=100000

# Telegram (opcional; habilitar agregando 'telegram' a CHANNELS_ENABLED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Credenciales de Meta WhatsApp Cloud API
META_ACCESS_TOKEN=EAAB_YOUR_META_PERMANENT_ACCESS_TOKEN_HERE
META_APP_SECRET=your_meta_app_secret_32_characters
META_PHONE_NUMBER_ID=123456789012345
WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here

# Proveedor LLM (cualquier API compatible con Chat Completions de OpenAI:
# OpenAI, Groq, OpenRouter, DeepSeek, Together, vLLM, Ollama, etc.)
LLM_API_KEY=your_llm_provider_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_MAX_RPM=60
LLM_MAX_TPM=100000

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_ws

# Ref del proyecto Supabase DEDICADO A PRUEBAS (no producción).
# La suite borra filas de negocio: apuntar aquí solo a una BD de test/staging.
TEST_PROJECT_REF=your_test_project_ref

# Backlog retenido: debajo se emite WARN; desde el umbral, ERROR (default 100)
BACKLOG_ALERT_THRESHOLD=100

# Pipeline de media (descarga en el dispatcher, no en el webhook)
MEDIA_STORAGE_ENABLED=true
MEDIA_STORAGE_DIR=./media
MEDIA_MAX_BYTES=10485760
MEDIA_RETENTION_DAYS=7

# Webhook opcional de on-call (solo https). Recibe CHANNEL_BACKLOG y CHANNEL_BACKLOG_RESOLVED.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
