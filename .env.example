# Puerto del servidor
PORT=3000
NODE_ENV=development

# Credenciales de Meta WhatsApp Cloud API
META_ACCESS_TOKEN=EAAB_YOUR_META_PERMANENT_ACCESS_TOKEN_HERE
META_APP_SECRET=your_meta_app_secret_32_characters
META_PHONE_NUMBER_ID=123456789012345
WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here

# Credenciales de Inteligencia Artificial
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_ws

# Ref del proyecto Supabase DEDICADO A PRUEBAS (no producción).
# La suite borra filas de negocio: apuntar aquí solo a una BD de test/staging.
TEST_PROJECT_REF=your_test_project_ref
