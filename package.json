{
  "name": "chatbot-ws",
  "version": "1.0.0",
  "description": "Plataforma omnicanal de atención, ventas y automatización con IA (WhatsApp, Instagram, Telegram, TikTok y canales propios) con motor LLM agnóstico de proveedor",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "autocannon -c 100 -d 10s -m POST -H \"Content-Type: application/json\" -b \"{\\\"object\\\":\\\"whatsapp_business_account\\\",\\\"entry\\\":[{\\\"changes\\\":[{\\\"value\\\":{\\\"messages\\\":[{\\\"from\\\":\\\"573001234567\\\",\\\"id\\\":\\\"wamid.loadtest\\\",\\\"type\\\":\\\"text\\\",\\\"text\\\":{\\\"body\\\":\\\"Hola\\\"}}]}}]}]}\" http://localhost:3000/webhook",
    "quality-gate": "tsx scripts/tools/chatbot_quality_gate.ts"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "meta-cloud-api",
    "llm",
    "openai-compatible",
    "fastify",
    "typescript"
  ],
  "author": "Chatbot WS Core Team",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.8",
    "autocannon": "^7.15.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
